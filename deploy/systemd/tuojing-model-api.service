[Unit]
Description=Tuojing Model Platform API
After=network.target

[Service]
Type=simple
WorkingDirectory=/data/model-platform/Tuojing_model_platform_service
Environment=HOME=/data/model-platform
Environment=PYTHONUNBUFFERED=1
ExecStart=/data/model-platform/Tuojing_model_platform_service/.venv/bin/tuojing-model-api --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
UMask=0027

[Install]
WantedBy=default.target
